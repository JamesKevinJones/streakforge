{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/streak/refresh", "destination": "/api/streak" },
    { "source": "/api/streak", "destination": "/api/streak" },
    { "source": "/api/settings", "destination": "/api/settings" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
